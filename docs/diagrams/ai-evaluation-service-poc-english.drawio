          <mxGeometry x="0" y="350" width="1740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lane-worker" value="Worker" style="swimlane;horizontal=0;startSize=110;fillColor=#fff0e6;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="f1">
          <mxGeometry x="0" y="500" width="1740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lane-engine" value="Evaluation Engine" style="swimlane;horizontal=0;startSize=110;fillColor=#fce4ec;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="f1">
          <mxGeometry x="0" y="650" width="1740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fc-submit" value="POST evaluation&lt;br&gt;+ Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-consumer">
          <mxGeometry x="120" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fa-validate" value="Authorize&lt;br&gt;Validate request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-api">
          <mxGeometry x="300" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fd-create" value="One transaction&lt;br&gt;Evaluation + Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-db">
          <mxGeometry x="480" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fa-accept" value="202 Accepted&lt;br&gt;evaluation_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-api">
          <mxGeometry x="660" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw-claim" value="Claim eligible Job&lt;br&gt;Lease + attempt count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-worker">
          <mxGeometry x="660" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe-eval" value="Deterministic evaluation&lt;br&gt;Authoritative verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-engine">
          <mxGeometry x="840" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw-decision" value="Optional Decision Judge&lt;br&gt;Jev confidence gate" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-worker">
          <mxGeometry x="1020" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fd-complete" value="Deterministic + shadow&lt;br&gt;One owned transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-db">
          <mxGeometry x="1200" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fc-poll" value="GET evaluation&lt;br&gt;Poll result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-consumer">
          <mxGeometry x="1380" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fc-review" value="POST review&lt;br&gt;Append review evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-consumer">
          <mxGeometry x="1560" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw-recover" value="Expired lease:&lt;br&gt;another Worker reclaims" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-worker">
          <mxGeometry x="1560" y="35" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fd-review" value="Append review record&lt;br&gt;Never overwrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-db">
          <mxGeometry x="1560" y="45" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fedge1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fc-submit" target="fa-validate" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fa-validate" target="fd-create" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fd-create" target="fa-accept" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge4" value="SKIP LOCKED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;" edge="1" source="fd-create" target="fw-claim" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fw-claim" target="fe-eval" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge6" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="fe-eval" target="fw-decision" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge7" value="shadow or null" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;" edge="1" source="fw-decision" target="fd-complete" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fd-complete" target="fc-poll" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fedge10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;" edge="1" source="fc-review" target="fd-review" parent="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fshadow-note" value="Jev is project-allowlisted and disabled by default. Uncertainty records an LLM escalation recommendation only; provider failure adds decision_judge_degraded and still completes deterministically." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="f1">
          <mxGeometry x="480" y="820" width="1010" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="states" name="03 State and HITL">
